<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.silo.slyguy.search" name="Silo &amp; SlyGuy Search" version="0.3.2" provider-name="Liam Robson">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
  </requires>

  <extension point="kodi.context.item">
    <menu id="kodi.core.main">
      <item library="context.py">
        <label>Search Streaming Services</label>
        <visible>Window.IsActive(MyPVRRecordings.xml) + !ListItem.IsFolder</visible>
      </item>
    </menu>
  </extension>

  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>

  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Search a PVR recording across Silo and installed SlyGuy video add-ons.</summary>
    <description lang="en_GB">Adds a PVR recording context-menu action that searches Silo and installed SlyGuy video add-ons using their existing Kodi plugin search interfaces.</description>
    <platform>all</platform>
    <license>GNU General Public License v3.0</license>
  </extension>
</addon>
